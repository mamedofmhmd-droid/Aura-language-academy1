generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Level {
  A1
  A2
  B1
  B2
}

model User {
  id            String          @id @default(uuid())
  fullName      String
  email         String          @unique
  passwordHash  String
  emailVerified Boolean         @default(false)
  verifyToken   String?
  resetToken    String?
  role          Role            @default(STUDENT)
  isBlocked     Boolean         @default(false)
  points        Int             @default(0)
  createdAt     DateTime        @default(now())
  subscriptions Subscription[]
  payments      Payment[]
  progress      VideoProgress[]
  quizAttempts  QuizAttempt[]
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  planPriceGel    Int      @default(15)
  status          String   @default("ACTIVE")
  autoRenew       Boolean  @default(true)
  nextBillingDate DateTime
  createdAt       DateTime @default(now())
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amountGel Decimal  @default(15.00)
  status    String
  createdAt DateTime @default(now())
}

model VideoLesson {
  id          String          @id @default(uuid())
  title       String
  level       Level
  bucket      String          @default("NEW")
  durationSec Int             @default(0)
  videoPath   String?
  subtitles   Subtitle[]
  words       Vocabulary[]
  verbs       Verb[]
  grammar     GrammarTopic[]
  questions   QuizQuestion[]
  progress    VideoProgress[]
  createdAt   DateTime        @default(now())
}

model Subtitle {
  id       String      @id @default(uuid())
  lessonId String
  lesson   VideoLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startSec Int
  textKa   String
  textAz   String
}

model Vocabulary {
  id            String       @id @default(uuid())
  lessonId      String?
  lesson        VideoLesson? @relation(fields: [lessonId], references: [id])
  level         Level
  wordKa        String
  meaningAz     String
  pronunciation String
  exampleKa     String
  exampleAz     String
}

model Verb {
  id          String       @id @default(uuid())
  lessonId    String?
  lesson      VideoLesson? @relation(fields: [lessonId], references: [id])
  level       Level
  infinitive  String
  meaningAz   String
  conjugation String
  example     String
}

model GrammarTopic {
  id       String       @id @default(uuid())
  lessonId String?
  lesson   VideoLesson? @relation(fields: [lessonId], references: [id])
  level    Level
  title    String
  ruleAz   String
  example  String
}

model QuizQuestion {
  id           String      @id @default(uuid())
  lessonId     String
  lesson       VideoLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question     String
  options      String[]
  correctIndex Int
}

model VideoProgress {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  lessonId   String
  lesson     VideoLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lastSec    Int         @default(0)
  completed  Boolean     @default(false)
  isFavorite Boolean     @default(false)
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lessonId  String
  scorePct  Int
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  createdAt DateTime @default(now())
}
